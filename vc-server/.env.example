# Copy this file to .env before running vc-core or vc-ws locally.
#   cp .env.example .env

# vc-core HTTP server
SERVER_PORT=5000
# SERVER_HOST can usually be left blank (binds to 0.0.0.0).
# SERVER_HOST=localhost

# MongoDB
DB_URI=mongodb://localhost:27017
DB_NAME=varchess

# Redis
REDIS_ADDR=localhost:6379
# If your Redis requires a password, set it here.
# REDIS_PASSWORD=your_redis_password

# JWT — change this to a strong random string in production.
JWT_SECRET_KEY=dev_secret_change_me

# Frontend origin (OAuth redirect target after login)
CLIENT_URL=http://localhost:5173
# Public URL of this API as seen by OAuth providers (callback base)
PUBLIC_API_URL=http://localhost:5000

# Optional OAuth — leave blank to hide social buttons until configured.
# Accepted names: GOOGLE_CLIENT_ID or GOOGLE_OAUTH_CLIENT_ID (same for secret / GitHub).
# GitHub: https://github.com/settings/developers → New OAuth App
#   Homepage: http://localhost:5173
#   Callback: http://localhost:5000/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Google: https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client
#   Authorized redirect: http://localhost:5000/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Set to any non-empty value so both services tolerate a missing .env file when
# running inside Docker (the container injects env vars directly).
ENVIRONMENT=development
