# Copy this file to .env before running vc-core or vc-ws locally.
#   cp .env.example .env

# vc-core HTTP server
SERVER_PORT=5000
# SERVER_HOST can usually be left blank (binds to 0.0.0.0).
# SERVER_HOST=localhost

# MongoDB
DB_URI=mongodb://localhost:27017
DB_NAME=varchess

# Redis
REDIS_ADDR=localhost:6379
# If your Redis requires a password, set it here.
# REDIS_PASSWORD=your_redis_password

# JWT — change this to a strong random string in production.
JWT_SECRET_KEY=dev_secret_change_me

# Set to any non-empty value so both services tolerate a missing .env file when
# running inside Docker (the container injects env vars directly).
ENVIRONMENT=development
